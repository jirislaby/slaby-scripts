#!/usr/bin/bash

OTHER_PATCH_DIR=$1
if [ -z "$OTHER_PATCH_DIR" -o ! -d "$OTHER_PATCH_DIR" ]; then
	echo "'$OTHER_PATCH_DIR' does not exist" >&2
	exit 1
fi

while read DIFF; do
	echo DIFF=$DIFF
	SHA=`git grep -h -m1 '^Git-commit:' "$DIFF"`
	if [ -z "$SHA" ]; then
		echo "no Git-commit in $DIFF" >&2
		continue
	fi
	OTHER_PATCH=`grep -l "$SHA" "$OTHER_PATCH_DIR"/*tch | head -1`
	if [ -z "$OTHER_PATCH" ]; then
		echo "no counterpart for $DIFF" >&2
		continue
	fi
	colordiff -u -I '^@@' \
		<(filterdiff "$OTHER_PATCH") \
		<(filterdiff "$DIFF")
done
