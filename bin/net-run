#!/usr/bin/bash

if [ $# -lt 3 ]; then
	exit 1
fi

RUN="$1"
shift
PATCH="$1"
shift

SHA=`sed -ne '/^Git-commit/ { s@^Git-commit: \([a-f0-9]*\)@\1@p ; q }' "$PATCH"`
if [ -z "$SHA" ]; then
	echo "No Git-commit found in $PATCH" >&2
	exit 1
fi
OPATCH=`grep -rl -- "$SHA" "$@" | grep -vFx -- "$PATCH" | head -1`
if [ -z "$OPATCH" ]; then
	echo "No other patch with $SHA found" >&2
	exit 1
fi

case "$RUN" in
	vim)
		exec vim "$OPATCH" "$PATCH" +'set ft=diff'
		;;
	colordiff)
		exec colordiff -u "$OPATCH" "$PATCH" | less
		;;
	*)
		echo "$OPATCH"
		echo "$PATCH"
		;;
esac
