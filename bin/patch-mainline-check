#!/usr/bin/bash

NO_MAIN=`mktemp`
trap 'rm -f "$NO_MAIN"' EXIT

git grep -i -L -E '^patch-mainline:\s*(yes|never.*|v?[-0-9.rc~^]*|[0-9a-f]{40})\s*$' 'patches.*/*' | grep -v '^patches\.xen\/' >"$NO_MAIN"

git grep -E -i '(from|acked-by|signed-off-by):.*@(suse|novell)\.' `cat "$NO_MAIN"`|sed 's@^\([^:]*\):.*:\s*\(.*\)@\2 ::: \1@'|sort -u
